# Bu dosyayi ".env" olarak kopyalayip degerleri doldurun. .env git'e GIRMEZ.

# --- Veritabani (zorunlu) ---
DATABASE_URL=postgresql://otel_foto_user:SIFRE@localhost:5432/otel_foto_db

# --- Otel adi: kiosk basliginda ve filigranda gorunur ---
# DEGISTIRINCE data/cache/ klasoru temizlenmeli (filigranli onbellek bayatlar).
HOTEL_NAME=OTEL ADI

# --- Operator girisi ---
# Sadece ILK aciliste kullanilir; sonrasinda sifre panelden degistirilir (DB'de hash'li).
OPERATOR_INITIAL_PASSWORD=otel123
# Operator oturum suresi (saat)
SESSION_HOURS=12

# --- Yukleme ---
MAX_UPLOAD_MB=60

# --- Siparis export klasoru ---
# Editorun calistigi klasor. Editor ayri makinedeyse Windows paylasimindaki yolu yazin.
# Bos birakilirsa: data/siparisler_export
# ORDERS_EXPORT_DIR=C:\Siparisler

# --- Gonderime hazir paketler ---
# "Gonderime Hazirla"ya basinca siparis_XXXX.zip buraya duser. Operatorun kolay
# ulasabilecegi bir klasor olsun (paylasilan klasor de olabilir).
# Bos birakilirsa: data/gonderilecek
# GONDERILECEK_DIR=C:\Gonderilecek
